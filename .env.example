# Supabase 接続情報
# Supabase ダッシュボード → Project Settings → API から取得します。
# Vercel では Project Settings → Environment Variables に同じ値を登録してください。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# HotPepper Beauty（SALON BOARD）のメール自動連携用（/api/hotpepper-webhook）
# どちらもブラウザには公開されないサーバー専用の値です。
# SUPABASE_SERVICE_ROLE_KEY: Supabase ダッシュボード → Project Settings → API → service_role key
# HOTPEPPER_WEBHOOK_SECRET: 自分で決めた合言葉（他人に予約データを送り込まれないようにするための鍵）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HOTPEPPER_WEBHOOK_SECRET=choose-a-long-random-secret
