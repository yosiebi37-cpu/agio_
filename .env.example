# Supabase 接続情報
# Supabase ダッシュボード → Project Settings → API から取得します。
# Vercel では Project Settings → Environment Variables に同じ値を登録してください。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# HotPepper Beauty（SALON BOARD）のメール自動連携用（/api/hotpepper-webhook）
# どちらもブラウザには公開されないサーバー専用の値です。
# SUPABASE_SERVICE_ROLE_KEY: Supabase ダッシュボード → Project Settings → API → service_role key
# HOTPEPPER_WEBHOOK_SECRET: 自分で決めた合言葉（他人に予約データを送り込まれないようにするための鍵）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HOTPEPPER_WEBHOOK_SECRET=choose-a-long-random-secret

# Square Appointmentsの予約自動連携用（/api/square-webhook）
# SQUARE_ACCESS_TOKEN: developer.squareup.com の Credentials ページにある Production Access Token
# SQUARE_WEBHOOK_SIGNATURE_KEY: SquareのWebhooks設定でエンドポイントを登録した時に発行される署名キー
# SQUARE_WEBHOOK_URL: Squareに登録したのと全く同じWebhookのURL（署名検証に使うため、1文字でも違うと失敗します）
SQUARE_ACCESS_TOKEN=your-square-production-access-token
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SQUARE_WEBHOOK_URL=https://agio-1vgc.vercel.app/api/square-webhook
